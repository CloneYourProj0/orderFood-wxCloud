<!--pages/home/home.wxml-->
<view class="page">
  <image src="/images/home/background.png" class="home-bg" mode="aspectFill"></image>

  <view class="home-action-area">
    <!-- 分店卡片 -->
    <view class="branch-card" hover-class="branch-card-hover" bindtap="openShopSelector">
      <view class="branch-card-content">
        <view class="branch-card-top">
          <view class="branch-label">当前分店</view>
          <view class="branch-change">切换</view>
        </view>
        <view class="branch-name one-row">
          {{currentShop.name || (locating ? '正在定位附近门店' : '请选择分店')}}
        </view>
        <view class="branch-address one-row">
          {{branchAddressText || '选择分店后开始点单'}}
        </view>
      </view>
      <view class="branch-arrow">›</view>
    </view>

    <!-- 当前充值金额 -->
    <view class="recharge-summary-card" hover-class="recharge-summary-card-hover" bindtap="goToRecharge">
      <view class="recharge-summary-main">
        <view class="recharge-summary-label">当前充值金额</view>
        <view class="recharge-summary-amount">
          <text class="recharge-summary-symbol">¥</text>
          <text>{{rechargeAmountText}}</text>
        </view>
      </view>
      <view class="recharge-summary-action">
        <text>去充值</text>
        <text class="recharge-summary-arrow">›</text>
      </view>
    </view>

    <!-- 堂食 / 外带 入口 -->
    <view class="bottom-actions">
      <view class="entry-card" hover-class="entry-card-hover" data-order-type="dineIn" bindtap="handleEntry">
        <image src="/images/home/dinein.png" class="entry-card-image" mode="widthFix"></image>
      </view>
      <view class="entry-card" hover-class="entry-card-hover" data-order-type="takeOut" bindtap="handleEntry">
        <image src="/images/home/takeout.png" class="entry-card-image" mode="widthFix"></image>
      </view>
    </view>
  </view>

  <!-- 分店选择弹窗 -->
  <shop-selector
    visible="{{showShopSelector}}"
    shop-list="{{shopList}}"
    current-shop="{{currentShop}}"
    locating="{{locating}}"
    bind:close="closeShopSelector"
    bind:select="onShopSelect"
    bind:locate="locateNearestShop"
  />
</view>
