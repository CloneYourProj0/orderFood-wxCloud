<!--pages/home/home.wxml-->
<view class="page">
  <image src="/images/home/background.png" class="home-bg" mode="aspectFill"></image>

  <view class="home-action-area">
    <!-- 分店卡片 -->
    <view class="branch-card" hover-class="branch-card-hover" bindtap="openShopSelector">
      <view class="branch-card-content">
        <view class="branch-card-top">
          <view class="branch-label">当前分店</view>
          <view class="branch-change">切换</view>
        </view>
        <view class="branch-name one-row">
          {{currentShop.name || (locating ? '正在定位附近门店' : '请选择分店')}}
        </view>
        <view class="branch-address one-row">
          {{branchAddressText || '选择分店后开始点单'}}
        </view>
      </view>
      <view class="branch-arrow">›</view>
    </view>

    <!-- 堂食 / 外带 入口 -->
    <view class="bottom-actions">
      <view class="entry-card" hover-class="entry-card-hover" data-order-type="dineIn" bindtap="handleEntry">
        <image src="/images/home/dinein.png" class="entry-card-image" mode="widthFix"></image>
      </view>
      <view class="entry-card" hover-class="entry-card-hover" data-order-type="takeOut" bindtap="handleEntry">
        <image src="/images/home/takeout.png" class="entry-card-image" mode="widthFix"></image>
      </view>
    </view>
  </view>

  <!-- 分店选择弹窗 -->
  <view class="shop-selector-mask" wx:if="{{showShopSelector}}" catchtap="closeShopSelector">
    <view class="shop-selector-panel" catchtap="stopPropagation">
      <view class="shop-selector-header">
        <view>
          <view class="shop-selector-title">选择分店</view>
          <view class="shop-selector-subtitle">定位后会优先展示最近门店</view>
        </view>
        <view class="modal-close-small" bindtap="closeShopSelector">×</view>
      </view>
      <view class="shop-selector-action" bindtap="locateNearestShop">
        <text>{{locating ? '正在获取当前位置...' : '获取定位并推荐最近分店'}}</text>
      </view>
      <scroll-view class="shop-selector-list" scroll-y>
        <view
          class="shop-card {{currentShop && currentShop._id === item._id ? 'active' : ''}}"
          wx:for="{{shopList}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="selectShop">
          <view class="shop-card-main">
            <view class="shop-card-title-row">
              <text class="shop-card-name">{{item.name || '未命名分店'}}</text>
              <text class="shop-card-distance" wx:if="{{item.distanceText}}">{{item.distanceText}}</text>
            </view>
            <view class="shop-card-address">{{item.address || item.description || '暂无门店地址'}}</view>
            <view class="shop-card-extra" wx:if="{{item.businessHours || item.phone}}">
              <text wx:if="{{item.businessHours}}">{{item.businessHours}}</text>
              <text wx:if="{{item.businessHours && item.phone}}"> · </text>
              <text wx:if="{{item.phone}}">{{item.phone}}</text>
            </view>
          </view>
          <text wx:if="{{currentShop && currentShop._id === item._id}}" class="shop-card-check">✓</text>
        </view>
        <view wx:if="{{shopList.length === 0}}" class="shop-empty">暂无分店，请在后台店铺设置中添加</view>
      </scroll-view>
    </view>
  </view>
</view>
