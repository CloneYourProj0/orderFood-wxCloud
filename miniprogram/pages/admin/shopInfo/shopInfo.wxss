/* pages/admin/shopInfo/shopInfo.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.shop-list-section,
.form-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.add-shop-btn {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  color: #e54d42;
  font-size: 26rpx;
  border: 2rpx solid #e54d42;
  border-radius: 10rpx;
  background: white;
}

.shop-tabs {
  white-space: nowrap;
}

.shop-tab {
  min-width: 180rpx;
  display: inline-flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx;
  margin-right: 18rpx;
  border: 2rpx solid #eeeeee;
  border-radius: 14rpx;
  background: #fafafa;
  vertical-align: top;
}

.shop-tab.active {
  border-color: #e54d42;
  background: #fff8f7;
}

.shop-tab.new {
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  color: #e54d42;
  font-size: 28rpx;
}

.shop-tab-name {
  max-width: 220rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-tab-status {
  display: inline-block;
  padding: 4rpx 12rpx;
  color: #07c160;
  font-size: 22rpx;
  border-radius: 999rpx;
  background: #eefbf3;
}

.shop-tab-status.closed {
  color: #999;
  background: #eeeeee;
}

.form-item {
  margin-bottom: 34rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item.half {
  flex: 1;
  min-width: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: white;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 10rpx;
  padding: 15rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 8rpx;
}

.switch-desc {
  font-size: 24rpx;
  color: #999;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.delete-btn,
.save-btn {
  flex: 1;
  padding: 30rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.delete-btn {
  color: #e54d42;
  background: white;
  border: 2rpx solid #e54d42;
}

.save-btn {
  color: white;
  background: linear-gradient(135deg, #e54d42 0%, #f37370 100%);
  box-shadow: 0 8rpx 30rpx rgba(229, 77, 66, 0.25);
}
